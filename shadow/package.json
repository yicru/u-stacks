{
  "name": "shadow",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vp build",
    "preview": "bun scripts/dev.ts preview",
    "test": "vp test run",
    "deploy": "dotenvx run --overload -f .dev.vars.production -- sh -c 'bun run build && wrangler deploy --secrets-file .dev.vars.production'",
    "cf-typegen": "wrangler types",
    "lint": "tsc -p tsconfig.check.json --noEmit && vp lint && vp fmt --check",
    "format": "vp lint --fix && vp fmt",
    "doctor": "react-doctor . --yes",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "quality": "bun run lint && bun run test && bun run doctor && bun run fallow",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:migrate:prod": "dotenvx run --overload -f .dev.vars.production -- drizzle-kit push --config drizzle.production.config.ts",
    "db:studio": "drizzle-kit studio",
    "generate:module": "scaffdog generate module",
    "setup": "bun scripts/setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@libsql/client": "0.17.4",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-beta.102",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "nanoid": "^5.1.15",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@dotenvx/dotenvx": "^1.75.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/devtools-vite": "^0.8.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "fallow": "3.6.0",
    "jsdom": "^29.1.1",
    "portless": "^0.14.0",
    "react-doctor": "0.8.1",
    "scaffdog": "^4.1.0",
    "shadcn": "^4.11.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plus": "0.2.1",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1"
  },
  "portless": {
    "name": "shadow"
  }
}
