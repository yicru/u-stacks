{
  "name": "shadow",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vp build",
    "preview": "bun scripts/dev.ts preview",
    "test": "vp test run",
    "cloudflare": "node scripts/cloudflare.ts",
    "deploy": "dotenvx run --overload -f .dev.vars.production -- bun run cloudflare -- deploy --secrets-file .dev.vars.production",
    "cf-typegen": "node node_modules/cf/bin/cf workers types",
    "lint": "bun run cf-typegen && tsc -p tsconfig.check.json --noEmit && vp lint && vp fmt --check",
    "format": "vp lint --fix && vp fmt",
    "doctor": "react-doctor . --yes",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "quality": "bun run lint && bun run test && bun run doctor && bun run fallow",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:migrate:prod": "dotenvx run --overload -f .dev.vars.production -- drizzle-kit push --config drizzle.production.config.ts",
    "db:studio": "drizzle-kit studio",
    "generate:module": "scaffdog generate module",
    "setup": "bun scripts/setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/config": "0.23.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@dotenvx/dotenvx": "^2.32.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.12",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.31.0",
    "jsdom": "^30.1.2",
    "portless": "^0.15.7",
    "react-doctor": "0.9.14",
    "scaffdog": "^4.1.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "portless": {
    "name": "shadow"
  }
}
